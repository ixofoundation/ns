{
	"@context": [
		"https://www.w3.org/ns/did/v1",
		{
			"@version": 1.1,
			"@protected": true,
			"id": "@id",
			"type": "@type",
			"did": "https://www.w3.org/ns/did/v1",
			"schema": "http://schema.org/",
			"xsd": "http://www.w3.org/2001/XMLSchema#",
			"con": {
				"@id": "https://w3id.org/ixo/vocab/v1/constitution#",
				"@prefix": true
			},
			"bil": {
				"@id": "https://w3id.org/ixo/vocab/v1/billing#",
				"@prefix": true
			},
			"dcterms": "http://purl.org/dc/terms/",
			"odrl": "http://www.w3.org/ns/odrl/2/",
			"prov": "http://www.w3.org/ns/prov#",
			"Assertion": "https://w3id.org/dcc/v1#Assertion",
			"zcap": "https://w3id.org/zcap/v1",
			"dataIntegrity": "https://w3id.org/security/data-integrity/v1",
			"verifiableCredential": "https://www.w3.org/2018/credentials/v1",
			"didixo": "https://w3id.org/ixo/protocol/identifiers/ixo/v1",
			"didx": "https://w3id.org/ixo/protocol/identifiers/x/v1",
			"entity": "https://w3id.org/ixo/protocol/entities/v1",
			"attribute": "https://w3id.org/ixo/protocol/attributes/v1",
			"claim": "https://w3id.org/ixo/protocol/claims/v1",
			"right": "https://w3id.org/ixo/protocol/accorded-rights/v1",
			"credential": "https://w3id.org/ixo/protocol/credentials/v1",
			"indicator": "https://w3id.org/ixo/protocol/indicators/v1",
			"identity": "https://w3id.org/ixo/protocol/identity/v1",
			"resource": "https://w3id.org/ixo/protocol/linked-resources/v1",
			"payment": "https://w3id.org/ixo/protocol/payments/v1",
			"method": "https://w3id.org/ixo/protocol/methods/v1",
			"token": "https://w3id.org/ixo/protocol/tokens/v1",
			"vocab": "https://w3id.org/ixo/vocab/v1",
			"startDate": "http://schema.org/startDate",
			"endDate": "http://schema.org/endDate",

			"constitution": {
				"@id": "con:hasConstitution",
				"@context": {
					"id": "@id",
					"type": "@type",
					"status": "con:status",
					"reason": "con:reason",
					"subject": {
						"@id": "con:constitutionalSubject",
						"@type": "@id"
					},
					"subject_profile": {
						"@id": "con:subjectProfile",
						"@context": {
							"subject_types": {
								"@id": "con:subjectType",
								"@type": "@id",
								"@container": "@set"
							},
							"archetypes": {
								"@id": "con:hasArchetype",
								"@type": "@id",
								"@container": "@set"
							},
							"identity": {
								"@id": "con:hasIdentity",
								"@type": "@id",
								"@container": "@set"
							},
							"purposes": {
								"@id": "con:hasPurpose",
								"@type": "@id",
								"@container": "@set"
							},
							"interests": {
								"@id": "con:hasInterests",
								"@type": "@id",
								"@container": "@set"
							},
							"values": {
								"@id": "con:hasValues",
								"@type": "@id",
								"@container": "@set"
							},
							"rights": {
								"@id": "con:hasRights",
								"@type": "@id",
								"@container": "@set"
							},
							"obligations": {
								"@id": "con:hasObligations",
								"@type": "@id",
								"@container": "@set"
							},
							"capabilities": {
								"@id": "con:hasCapabilities",
								"@type": "@id",
								"@container": "@set"
							},
							"claims": {
								"@id": "con:hasClaims",
								"@type": "@id",
								"@container": "@set"
							},
							"wallets": {
								"@id": "con:hasWallet",
								"@type": "@id",
								"@container": "@set"
							},
							"authorities": {
								"@id": "con:hasAuthority",
								"@type": "@id",
								"@container": "@set"
							},
							"memory": {
								"@id": "con:hasMemory",
								"@type": "@id",
								"@container": "@set"
							},
							"evidence_policies": {
								"@id": "con:hasEvidencePolicy",
								"@type": "@id",
								"@container": "@set"
							},
							"evaluation_policies": {
								"@id": "con:hasEvaluationPolicy",
								"@type": "@id",
								"@container": "@set"
							},
							"decision_policies": {
								"@id": "con:hasDecisionPolicy",
								"@type": "@id",
								"@container": "@set"
							},
							"settlement_policies": {
								"@id": "con:hasSettlementPolicy",
								"@type": "@id",
								"@container": "@set"
							},
							"governance": {
								"@id": "con:hasGovernance",
								"@type": "@id",
								"@container": "@set"
							},
							"custodians": {
								"@id": "con:hasCustodian",
								"@type": "@id",
								"@container": "@set"
							},
							"stewards": {
								"@id": "con:hasSteward",
								"@type": "@id",
								"@container": "@set"
							},
							"owners": {
								"@id": "con:hasOwner",
								"@type": "@id",
								"@container": "@set"
							},
							"beneficiaries": {
								"@id": "con:hasBeneficiary",
								"@type": "@id",
								"@container": "@set"
							},
							"oracles": {
								"@id": "con:hasOracle",
								"@type": "@id",
								"@container": "@set"
							},
							"agentic_twins": {
								"@id": "con:hasAgenticTwin",
								"@type": "@id",
								"@container": "@set"
							}
						}
					},
					"legal_effect": "con:legalEffect",
					"jurisdiction": {
						"@id": "con:hasJurisdiction",
						"@type": "@id"
					},
					"authority_evidence": {
						"@id": "con:authorityEvidence",
						"@type": "@id",
						"@container": "@set"
					},
					"norms": {
						"@id": "con:hasNorm",
						"@type": "@id",
						"@container": "@set"
					},
					"instruments": {
						"@id": "con:hasInstrument",
						"@container": "@set"
					},
					"document_ref": {
						"@id": "con:documentReference",
						"@type": "@id"
					},
					"functions": {
						"@id": "con:instrumentFunction",
						"@container": "@set"
					},
					"canonical": {
						"@id": "con:canonical",
						"@type": "xsd:boolean"
					},
					"effective_from": {
						"@id": "con:effectiveFrom",
						"@type": "xsd:dateTime"
					},
					"effective_until": {
						"@id": "con:effectiveUntil",
						"@type": "xsd:dateTime"
					},
					"governance": "con:governance",
					"authority_sources": {
						"@id": "con:authoritySource",
						"@type": "@id",
						"@container": "@set"
					},
					"decision_procedure": {
						"@id": "con:decisionProcedure",
						"@type": "@id"
					},
					"amendment_procedure": {
						"@id": "con:amendmentProcedure",
						"@type": "@id"
					},
					"interpretation_procedure": {
						"@id": "con:interpretationProcedure",
						"@type": "@id"
					},
					"dispute_resolution_procedure": {
						"@id": "con:disputeResolutionProcedure",
						"@type": "@id"
					},
					"suspension_procedure": {
						"@id": "con:suspensionProcedure",
						"@type": "@id"
					},
					"dissolution_procedure": {
						"@id": "con:dissolutionProcedure",
						"@type": "@id"
					},
					"execution": "con:execution",
					"mode": "con:mode",
					"implementations": {
						"@id": "con:implementedBy",
						"@type": "@id",
						"@container": "@set"
					},
					"conformance_tests": {
						"@id": "con:conformanceTest",
						"@type": "@id",
						"@container": "@set"
					},
					"enforcement_points": {
						"@id": "con:enforcedBy",
						"@type": "@id",
						"@container": "@set"
					},
					"failure_policy": "con:failurePolicy",
					"human_review_required_for": {
						"@id": "con:humanReviewRequiredFor",
						"@container": "@set"
					},
					"constitutional_ai": "con:constitutionalAI",
					"applies_to_agents": {
						"@id": "con:appliesToAgent",
						"@type": "@id",
						"@container": "@set"
					},
					"principles": {
						"@id": "con:hasPrinciple",
						"@type": "@id",
						"@container": "@set"
					},
					"critique_procedure": {
						"@id": "con:critiqueProcedure",
						"@type": "@id"
					},
					"revision_procedure": {
						"@id": "con:revisionProcedure",
						"@type": "@id"
					},
					"model_profile": {
						"@id": "con:modelProfile",
						"@type": "@id"
					},
					"conflict_policy": "con:conflictPolicy",
					"audit_record": {
						"@id": "con:auditRecord",
						"@type": "@id"
					}
				}
			},

			"UsageClaim": {
				"@id": "bil:UsageClaim",
				"@context": {
					"id": "@id",
					"type": "@type",
					"amount": "bil:amount",
					"oracleDid": {
						"@id": "bil:oracleDid",
						"@type": "@id"
					},
					"oracleEntityDid": {
						"@id": "bil:oracleEntityDid",
						"@type": "@id"
					},
					"oracleName": "bil:oracleName",
					"userDid": {
						"@id": "bil:userDid",
						"@type": "@id"
					},
					"collectionId": "bil:collectionId"
				}
			},

			"UsageBillingSettlement": {
				"@id": "bil:UsageBillingSettlement",
				"@context": {
					"id": "@id",
					"type": "@type",
					"settlementId": "bil:settlementId",
					"customerDid": {
						"@id": "bil:customerDid",
						"@type": "@id"
					},
					"deedDid": {
						"@id": "bil:deedDid",
						"@type": "@id"
					},
					"collectionId": "bil:collectionId",
					"resultStatus": "bil:resultStatus",
					"request": "bil:request",
					"workSummary": "bil:workSummary",
					"proofs": "bil:verificationTrail",
					"amount": {
						"@id": "bil:amount",
						"@container": "@set",
						"@context": {
							"amount": "bil:coinValue",
							"denom": "bil:coinDenom"
						}
					}
				}
			},

			"CosmosAccountAddress": "https://w3id.org/ixo/protocol/methods/v1#CosmosAccountAddress",
			"blockchainAccountID": {
				"@id": "https://w3id.org/ixo/protocol/methods/v1#blockchainAccountID"
			},

			"linkedResource": {
				"@id": "https://w3id.org/ixo/protocol/linked-resources/v1#linkedResource",
				"@container": "@set",
				"@context": {
					"id": "@id",
					"type": "@type",
					"description": "schema:description",
					"mediaType": "https://w3id.org/ixo/protocol/linked-resources/v1#mediaType",
					"serviceEndpoint": { "@id": "https://w3id.org/ixo/protocol/linked-resources/v1#serviceEndpoint", "@type": "@id" },
					"proof": "https://w3id.org/ixo/protocol/linked-resources/v1#proof",
					"encrypted": "https://w3id.org/ixo/protocol/linked-resources/v1#encrypted",
					"right": "https://w3id.org/ixo/protocol/linked-resources/v1#right"
				}
			},

			"linkedClaim": {
				"@id": "https://w3id.org/ixo/protocol/claims/v1#linkedClaim",
				"@container": "@set",
				"@context": {
					"id": "@id",
					"type": "@type",
					"description": "schema:description",
					"mediaType": "https://w3id.org/ixo/protocol/claims/v1#mediaType",
					"serviceEndpoint": { "@id": "https://w3id.org/ixo/protocol/claims/v1#serviceEndpoint", "@type": "@id" },
					"proof": "https://w3id.org/ixo/protocol/claims/v1#proof",
					"encrypted": "https://w3id.org/ixo/protocol/claims/v1#encrypted",
					"right": "https://w3id.org/ixo/protocol/claims/v1#right"
				}
			},

			"linkedEntity": {
				"@id": "https://w3id.org/ixo/protocol/entities/v1#linkedEntity",
				"@container": "@set",
				"@context": {
					"id": "@id",
					"type": "@type",
					"description": "schema:description",
					"relationship": "https://w3id.org/ixo/protocol/entities/v1#relationship",
					"service": "https://w3id.org/ixo/protocol/entities/v1#service"
				}
			},

			"accordedRight": {
				"@id": "https://w3id.org/ixo/protocol/accorded-rights/v1#accordedRight",
				"@container": "@set",
				"@context": {
					"id": "@id",
					"type": "@type",
					"description": "schema:description",
					"mediaType": "https://w3id.org/ixo/protocol/accorded-rights/v1#mediaType",
					"service": "https://w3id.org/ixo/protocol/accorded-rights/v1#service",
					"serviceEndpoint": { "@id": "https://w3id.org/ixo/protocol/accorded-rights/v1#serviceEndpoint", "@type": "@id" }
				}
			},

			"metadata": {
				"@id": "https://w3id.org/ixo/vocab/v1#metadata",
				"@context": {
					"versionId": "https://w3id.org/ixo/vocab/v1#versionId",
					"created": { "@id": "http://schema.org/dateCreated", "@type": "xsd:dateTime" },
					"updated": { "@id": "http://schema.org/dateModified", "@type": "xsd:dateTime" },
					"deactivated": { "@id": "https://w3id.org/ixo/vocab/v1#deactivated", "@type": "xsd:boolean" }
				}
			}
		}
	]
}
