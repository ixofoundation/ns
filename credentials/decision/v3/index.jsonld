{
  "@context": {
    "@protected": true,
    "@version": 1.1,
    "ixo": "https://w3id.org/ixo/credentials/decision/v3#",
    "udid": "https://github.com/impactsai/udid/ns#",

    "DecisionCredential": "udid:DecisionCredential",
    "decision": { "@id": "udid:decision", "@type": "@json" },

    "ClaimDecisionCredential": "ixo:ClaimDecisionCredential",
    "ClaimReviewAttestation": "ixo:ClaimReviewAttestation",
    "evaluation": { "@id": "ixo:evaluation", "@type": "@json" },
    "reviewer": { "@id": "ixo:reviewer", "@type": "@id" }
  }
}
